# Server-only. Copy to .env.local; never commit real values.
MONGODB_URI=
# Optional if the URI already includes the database name.
MONGODB_DB_NAME=make-my-marriage
NEXT_PUBLIC_APP_URL=http://localhost:3000

AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary AWS credentials.
AWS_SESSION_TOKEN=

CRON_SECRET=
# Provider-neutral sender; not used until a real EmailService adapter is configured.
EMAIL_FROM=
# Random server-only secret (at least 32 characters) for hashing rate-limit keys.
# Generate separately for each environment; never use this example as a value.
AUTH_RATE_LIMIT_SECRET=
